---
import { buttonClasses } from '../../lib/uiClasses';

interface Props {
  as?: 'button' | 'a';
  class?: string;
  href?: string;
  id?: string;
  rel?: string;
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: keyof typeof buttonClasses;
}

const {
  as = 'button',
  class: className = '',
  href = '#',
  id,
  rel,
  target,
  type = 'button',
  variant = 'primary',
} = Astro.props;

const classes = `${buttonClasses[variant]} ${className}`.trim();
---

{
  as === 'a' ? (
    <a class={classes} href={href} id={id} rel={rel} target={target}>
      <slot />
    </a>
  ) : (
    <button class={classes} id={id} type={type}>
      <slot />
    </button>
  )
}
