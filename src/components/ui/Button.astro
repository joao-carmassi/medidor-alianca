---
import { withBase, withBaseAnchor } from '../../lib/paths';
import { buttonClasses } from '../../lib/uiClasses';

interface Props {
  as?: 'button' | 'a';
  class?: string;
  href?: string;
  id?: string;
  rel?: string;
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: keyof typeof buttonClasses;
}

const {
  as = 'button',
  class: className = '',
  href = '#',
  id,
  rel,
  target,
  type = 'button',
  variant = 'primary',
} = Astro.props;

function resolveHref(value: string): string {
  if (value.startsWith('#')) {
    return withBaseAnchor(value);
  }

  if (value.startsWith('/')) {
    return withBase(value);
  }

  return value;
}

const classes = `${buttonClasses[variant]} ${className}`.trim();
const resolvedHref = resolveHref(href);
---

{
  as === 'a' ? (
    <a class={classes} href={resolvedHref} id={id} rel={rel} target={target}>
      <slot />
    </a>
  ) : (
    <button class={classes} id={id} type={type}>
      <slot />
    </button>
  )
}
