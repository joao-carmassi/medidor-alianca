---
interface Props {
  icon: 'card' | 'ring';
}

const { icon } = Astro.props;
---

<div class='flex items-center gap-3 text-left text-[14.5px] text-[#d8d2c4]'>
  <span
    class='inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/45 text-[#d4af37]'
    aria-hidden='true'
  >
    {
      icon === 'card' ? (
        <svg viewBox='0 0 40 26' width='28' height='18'>
          <rect
            x='1'
            y='1'
            width='38'
            height='24'
            rx='4'
            fill='none'
            stroke='currentColor'
            stroke-width='1.4'
          />
          <rect x='5' y='6' width='9' height='6' rx='1.3' fill='currentColor' />
        </svg>
      ) : (
        <svg viewBox='0 0 40 40' width='20' height='20'>
          <circle
            cx='20'
            cy='20'
            r='17'
            fill='none'
            stroke='currentColor'
            stroke-width='3.4'
          />
        </svg>
      )
    }
  </span>
  <span><slot /></span>
</div>
