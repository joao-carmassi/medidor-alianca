---
import Button from '../ui/Button.astro';
import Stepper from './Stepper.astro';
import {
  displayFont,
  eyebrowClass,
  goldGradient,
  panelClass,
  sectionTitleClass,
} from '../../lib/uiClasses';
---

<section
  class={panelClass}
  id='panel-result'
  data-panel='result'
  aria-hidden='true'
  hidden
>
  <Stepper current={3} />

  <p class={eyebrowClass}>Resultado</p>
  <h2 class={sectionTitleClass}>O seu aro é</h2>

  <div
    class='mb-5 flex flex-col items-center rounded-[26px] border border-[#d4af37]/45 bg-[#141210] bg-[linear-gradient(180deg,rgba(212,175,55,.1),rgba(255,255,255,.02))] px-5 py-9 text-center'
  >
    <span
      class={`${displayFont} ${goldGradient} bg-clip-text text-8xl font-semibold leading-none text-transparent drop-shadow-[0_10px_30px_rgba(212,175,55,.25)] sm:text-9xl`}
      id='result-aro'
    >
      16
    </span>
    <span class='mt-3 text-sm text-[#d8d2c4]'>
      Diâmetro interno de
      <strong class='font-semibold text-[#f3dfa4]' id='result-diameter'>
        17,8 mm
      </strong>
    </span>
  </div>

  <p
    class='mb-7 rounded-r-md border-l-2 border-[#c9a24b] bg-[#d4af37]/5 px-4 py-3.5 text-[13px] leading-relaxed text-[#9c9587]'
  >
    <strong class='font-semibold text-[#d4af37]'>Atenção:</strong> esta medição
    possui margem de erro de 1 a 2 aros para mais ou para menos. Para uma medida
    exata e definitiva, recomendamos procurar uma de nossas lojas Daniel
    Carmassi.
  </p>

  <div class='mt-2 flex flex-col items-stretch gap-4 sm:flex-row'>
    <Button
      as='a'
      class='w-full flex-1'
      href='#'
      id='btn-whatsapp'
      target='_blank'
      rel='noopener'
    >
      Falar no WhatsApp
    </Button>
    <Button variant='ghost' class='w-full flex-1' id='btn-remeasure'>
      Medir de novo
    </Button>
  </div>
</section>
