---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import CalibrationPanel from '../components/medidor/CalibrationPanel.astro';
import HeroPanel from '../components/medidor/HeroPanel.astro';
import MeasurementPanel from '../components/medidor/MeasurementPanel.astro';
import ResultPanel from '../components/medidor/ResultPanel.astro';
import { withBase } from '../lib/paths';
import { uiFont } from '../lib/uiClasses';
import '../styles/global.css';

const faviconPngHref = withBase('/favicon-96x96.png');
const faviconSvgHref = withBase('/favicon.svg');
const shortcutIconHref = withBase('/favicon.ico');
const appleTouchIconHref = withBase('/apple-touch-icon.png');
const manifestHref = withBase('/site.webmanifest');
---

<html lang='pt-BR' class='min-h-full bg-[#0a0a09]'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1, viewport-fit=cover'
    />
    <title>Medidor de Aliança — Daniel Carmassi</title>
    <meta
      name='description'
      content='Descubra o aro da sua aliança em três passos, usando apenas um cartão de crédito e um anel que já sirva. Medidor oficial Daniel Carmassi.'
    />
    <meta name='theme-color' content='#0b0b0b' />
    <link rel='icon' type='image/png' href={faviconPngHref} sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href={faviconSvgHref} />
    <link rel='shortcut icon' href={shortcutIconHref} />
    <link rel='apple-touch-icon' sizes='180x180' href={appleTouchIconHref} />
    <link rel='manifest' href={manifestHref} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
  </head>
  <body
    class={`${uiFont} min-h-dvh overflow-x-hidden bg-[linear-gradient(180deg,#0a0a09_0%,#141210_56%,#0a0a09_100%)] text-base leading-relaxed text-[#d8d2c4] antialiased selection:bg-[#d4af37]/35 selection:text-white`}
  >
    <div
      class='relative z-10 flex min-h-dvh flex-col items-center px-5 pb-5 pt-6 sm:pt-10'
    >
      <SiteHeader />

      <main
        id='main'
        class='flex w-full max-w-[560px] flex-1 flex-col justify-center'
      >
        <HeroPanel />
        <CalibrationPanel />
        <MeasurementPanel />
        <ResultPanel />
      </main>

      <SiteFooter />
    </div>

    <script>
      import '../ts/app';
    </script>
  </body>
</html>
