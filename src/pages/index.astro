---
import '../styles/global.css';

const goldGradient =
  'bg-[linear-gradient(135deg,#f3dfa4_0%,#d4af37_38%,#c9a24b_65%,#b8860b_100%)]';

const panelClass = 'flex flex-col';
const eyebrowClass = 'mb-3 text-xs font-semibold uppercase text-[#d4af37]';
const displayFont = "font-['Cormorant_Garamond']";
const uiFont = "font-['Inter']";
const sectionTitleClass = `${displayFont} mb-3 text-3xl font-medium leading-tight text-[#f3efe6] sm:text-4xl`;
const instructionClass = 'mb-6 max-w-[54ch] text-[15px] leading-relaxed text-[#d8d2c4]';

const buttonBase =
  'relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-transparent px-8 py-4 text-sm font-semibold uppercase text-inherit no-underline transition duration-200 active:translate-y-px active:scale-[.99]';
const primaryButtonClass = `${buttonBase} ${goldGradient} text-[#17130a] shadow-[0_10px_28px_-10px_rgba(212,175,55,.55)] hover:shadow-[0_14px_34px_-10px_rgba(212,175,55,.7)]`;
const ghostButtonClass = `${buttonBase} border-[#d4af37]/45 bg-transparent text-[#f3dfa4] hover:border-[#d4af37] hover:bg-[#d4af37]/10`;
const linkButtonClass =
  'inline-flex cursor-pointer items-center justify-center rounded-none border-0 bg-transparent px-1 py-2 text-[13.5px] font-medium text-[#9c9587] transition hover:text-[#d4af37]';

const stepItemBase = 'flex items-center gap-2 text-[#9c9587]';
const stepNumBase = `${displayFont} inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/25 text-sm text-[#9c9587]`;
const stepNumCurrent = `${stepNumBase} ${goldGradient} border-[#d4af37] text-[#0a0a09] shadow-[0_0_0_4px_rgba(212,175,55,.14)]`;
const stepNumDone = `${stepNumBase} border-[#c9a24b] text-[#c9a24b]`;
const stepLabelClass = 'hidden text-[11px] uppercase text-inherit min-[480px]:inline';
const stepSeparatorClass = 'h-px w-7 bg-[#d4af37]/25';

const stageClass =
  'relative mb-5 flex min-h-48 items-center justify-center overflow-hidden rounded-[26px] border border-[#d4af37]/20 bg-[#141210] bg-[linear-gradient(180deg,rgba(255,255,255,.03),rgba(212,175,55,.04))] px-5 py-8';
const ringStageClass =
  'relative mb-5 flex min-h-56 items-center justify-center overflow-visible px-5 py-8';
const guideWrapClass = 'pointer-events-none absolute inset-5';
const guideHorizontalClass =
  'absolute left-0 right-0 top-0 h-px bg-[repeating-linear-gradient(to_right,rgba(212,175,55,.45)_0_4px,transparent_4px_9px)]';
const guideVerticalClass =
  'absolute bottom-0 left-0 top-0 w-px bg-[repeating-linear-gradient(to_bottom,rgba(212,175,55,.45)_0_4px,transparent_4px_9px)]';

const controlLabelClass = 'text-xs font-semibold uppercase text-[#9c9587]';
const controlRowClass = 'flex items-center gap-3.5';
const fineButtonClass =
  'flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[#d4af37]/45 bg-[#1b1815] text-lg leading-none text-[#f3dfa4] transition hover:border-[#d4af37] hover:bg-[#221d15] active:scale-95';
const sliderClass =
  'h-6 w-full flex-1 cursor-pointer appearance-none bg-transparent [&::-moz-range-thumb]:h-[18px] [&::-moz-range-thumb]:w-[18px] [&::-moz-range-thumb]:rotate-45 [&::-moz-range-thumb]:rounded-[3px] [&::-moz-range-thumb]:border [&::-moz-range-thumb]:border-white/20 [&::-moz-range-thumb]:bg-[linear-gradient(135deg,#f3dfa4_0%,#d4af37_38%,#c9a24b_65%,#b8860b_100%)] [&::-moz-range-thumb]:shadow-[0_4px_12px_-2px_rgba(212,175,55,.7)] [&::-moz-range-track]:h-0.5 [&::-moz-range-track]:rounded-full [&::-moz-range-track]:bg-[linear-gradient(90deg,rgba(212,175,55,.45),rgba(212,175,55,.22))] [&::-webkit-slider-runnable-track]:h-0.5 [&::-webkit-slider-runnable-track]:rounded-full [&::-webkit-slider-runnable-track]:bg-[linear-gradient(90deg,rgba(212,175,55,.45),rgba(212,175,55,.22))] [&::-webkit-slider-thumb]:mt-[-8px] [&::-webkit-slider-thumb]:h-[18px] [&::-webkit-slider-thumb]:w-[18px] [&::-webkit-slider-thumb]:rotate-45 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-[3px] [&::-webkit-slider-thumb]:border [&::-webkit-slider-thumb]:border-white/20 [&::-webkit-slider-thumb]:bg-[linear-gradient(135deg,#f3dfa4_0%,#d4af37_38%,#c9a24b_65%,#b8860b_100%)] [&::-webkit-slider-thumb]:shadow-[0_4px_12px_-2px_rgba(212,175,55,.7)] active:[&::-webkit-slider-thumb]:scale-110';

const readoutClass =
  'flex flex-1 flex-col gap-1 rounded-[14px] border border-[#d4af37]/20 bg-[#141210] px-4 py-3.5';
const readoutAccentClass =
  'flex flex-1 flex-col gap-1 rounded-[14px] border border-[#d4af37]/45 bg-[linear-gradient(180deg,rgba(212,175,55,.08),transparent)] px-4 py-3.5';
const readoutLabelClass = 'text-[11px] uppercase text-[#9c9587]';
const readoutValueClass = `${displayFont} text-2xl font-medium text-[#f3efe6] tabular-nums`;
---

<html lang='pt-BR' class='min-h-full bg-[#0a0a09]'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1, viewport-fit=cover'
    />
    <title>Medidor de Aliança — Daniel Carmassi</title>
    <meta
      name='description'
      content='Descubra o aro da sua aliança em três passos, usando apenas um cartão de crédito e um anel que já sirva. Medidor oficial Daniel Carmassi.'
    />
    <meta name='theme-color' content='#0b0b0b' />
    <link rel='icon' type='image/svg+xml' href='/assets/favicon.svg' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
  </head>
  <body
    class={`${uiFont} min-h-dvh overflow-x-hidden bg-[linear-gradient(180deg,#0a0a09_0%,#141210_56%,#0a0a09_100%)] text-base leading-relaxed text-[#d8d2c4] antialiased selection:bg-[#d4af37]/35 selection:text-white`}
  >
    <div
      class='relative z-10 flex min-h-dvh flex-col items-center px-5 pb-5 pt-6 sm:pt-10'
    >
      <header class='mb-5 flex w-full max-w-[560px] justify-center sm:mb-10'>
        <img
          class='h-auto w-40 drop-shadow-[0_6px_26px_rgba(212,175,55,.14)] sm:w-48'
          src='/assets/danielcarmassilogo.png'
          alt='Daniel Carmassi — Joalheiro'
        />
      </header>

      <main id='main' class='flex w-full max-w-[560px] flex-1 flex-col justify-center'>
        <section
          class={`${panelClass} items-center pt-2 text-center`}
          id='panel-hero'
          data-panel='hero'
        >
          <p class={eyebrowClass}>Medidor de Aliança</p>
          <h1
            class={`${displayFont} mb-5 text-5xl font-medium leading-tight text-[#f3efe6] sm:text-6xl`}
          >
            Descubra
            <span
              class={`${goldGradient} bg-clip-text font-medium italic text-transparent`}
            >
              o seu aro
            </span>
          </h1>
          <p class='mb-7 max-w-[42ch] text-[17px] leading-relaxed text-[#d8d2c4]'>
            Um método simples e preciso, feito para ser resolvido em menos de
            dois minutos, usando apenas um cartão de crédito comum e uma aliança
            que já sirva em você.
          </p>

          <div
            class='mx-auto mb-8 flex flex-col items-start gap-3 rounded-[14px] border border-[#d4af37]/20 bg-white/[.02] px-5 py-4'
            role='note'
            aria-label='O que você vai precisar'
          >
            <div class='flex items-center gap-3 text-left text-[14.5px] text-[#d8d2c4]'>
              <span
                class='inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/45 text-[#d4af37]'
                aria-hidden='true'
              >
                <svg viewBox='0 0 40 26' width='28' height='18'>
                  <rect
                    x='1'
                    y='1'
                    width='38'
                    height='24'
                    rx='4'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.4'></rect>
                  <rect
                    x='5'
                    y='6'
                    width='9'
                    height='6'
                    rx='1.3'
                    fill='currentColor'></rect>
                </svg>
              </span>
              <span>Um cartão de crédito ou débito comum</span>
            </div>
            <div class='flex items-center gap-3 text-left text-[14.5px] text-[#d8d2c4]'>
              <span
                class='inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d4af37]/45 text-[#d4af37]'
                aria-hidden='true'
              >
                <svg viewBox='0 0 40 40' width='20' height='20'>
                  <circle
                    cx='20'
                    cy='20'
                    r='17'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='3.4'></circle>
                </svg>
              </span>
              <span>Uma aliança ou anel que já sirva no dedo desejado</span>
            </div>
          </div>

          <div class='flex flex-col items-center gap-3.5' id='hero-actions-fresh'>
            <button class={primaryButtonClass} type='button' id='btn-start'>
              Começar
            </button>
          </div>

          <div
            class='flex flex-col items-center gap-3.5'
            id='hero-actions-returning'
            hidden
          >
            <p class='text-sm text-[#9c9587]'>
              Encontramos uma calibração salva neste dispositivo.
            </p>
            <div class='flex flex-wrap justify-center gap-3.5'>
              <button class={primaryButtonClass} type='button' id='btn-continue'>
                Continuar medição
              </button>
              <button
                class={linkButtonClass}
                type='button'
                id='btn-recalibrate-from-hero'
              >
                Recalibrar cartão
              </button>
            </div>
          </div>
        </section>

        <section
          class={panelClass}
          id='panel-step1'
          data-panel='step1'
          aria-hidden='true'
          hidden
        >
          <nav class='mb-7' aria-label='Progresso'>
            <ol class='flex items-center gap-2.5'>
              <li class={stepItemBase}>
                <span class={stepNumCurrent}>I</span>
                <span class={stepLabelClass}>Calibrar</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumBase}>II</span>
                <span class={stepLabelClass}>Medir</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumBase}>III</span>
                <span class={stepLabelClass}>Resultado</span>
              </li>
            </ol>
          </nav>

          <p class={eyebrowClass}>Passo I</p>
          <h2 class={sectionTitleClass}>Calibre com um cartão</h2>
          <p class={instructionClass}>
            Encoste um cartão de crédito na tela e ajuste o retângulo abaixo até
            ele ficar exatamente do mesmo tamanho — alinhe um dos cantos do
            cartão real com o canto marcado em dourado.
          </p>

          <div class={stageClass} id='card-stage-frame'>
            <div class={guideWrapClass} aria-hidden='true'>
              <span class={guideHorizontalClass}></span>
              <span class={guideVerticalClass}></span>
            </div>
            <div
              class='relative overflow-hidden rounded-xl border-2 border-[#d4af37] bg-[linear-gradient(155deg,#1d1a15,#100e0b_60%,#1b1712)] shadow-[inset_0_1px_0_rgba(255,255,255,.06),0_18px_40px_-20px_rgba(0,0,0,.8),0_0_0_1px_rgba(212,175,55,.08)] transition-[width,height] duration-75'
              id='card-object'
              role='img'
              aria-label='Retângulo de calibração no formato de um cartão de crédito'
            >
              <span
                class='absolute inset-[-40%_-10%] rotate-[-6deg] bg-[linear-gradient(115deg,transparent_40%,rgba(212,175,55,.16)_50%,transparent_60%)]'
                aria-hidden='true'
              ></span>
              <span
                class='absolute left-[9%] top-[20%] aspect-[4/3] w-[17%] rounded-[3px] bg-[linear-gradient(155deg,#f3dfa4,#b8860b)] opacity-85'
                aria-hidden='true'
              ></span>
              <span
                class='absolute bottom-[10%] right-[8%] text-[11px] text-[#d4af37]/35'
              >
                CARTÃO
              </span>
            </div>
          </div>

          <div class='mb-2' id='card-control'>
            <div class='mb-2.5 flex items-baseline justify-between'>
              <label class={controlLabelClass} for='card-slider'>
                Tamanho do cartão
              </label>
              <span class='text-[12.5px] tabular-nums text-[#d4af37]' id='card-px-readout'>
                320 px
              </span>
            </div>
            <div class={controlRowClass}>
              <button
                class={fineButtonClass}
                type='button'
                id='card-dec'
                aria-label='Diminuir 1 pixel'
              >
                &minus;
              </button>
              <input
                class={sliderClass}
                type='range'
                id='card-slider'
                min='120'
                max='600'
                step='1'
                value='320'
                aria-describedby='card-px-readout'
              />
              <button
                class={fineButtonClass}
                type='button'
                id='card-inc'
                aria-label='Aumentar 1 pixel'
              >
                &plus;
              </button>
            </div>
          </div>

          <div class='mt-2 flex items-center justify-between gap-4'>
            <button class={linkButtonClass} type='button' id='btn-back-to-hero'>
              &lsaquo; Voltar
            </button>
            <button class={primaryButtonClass} type='button' id='btn-calibrate-done'>
              Pronto, está do tamanho
            </button>
          </div>
        </section>

        <section
          class={panelClass}
          id='panel-step2'
          data-panel='step2'
          aria-hidden='true'
          hidden
        >
          <nav class='mb-7' aria-label='Progresso'>
            <ol class='flex items-center gap-2.5'>
              <li class={stepItemBase}>
                <span class={stepNumDone}>I</span>
                <span class={stepLabelClass}>Calibrar</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumCurrent}>II</span>
                <span class={stepLabelClass}>Medir</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumBase}>III</span>
                <span class={stepLabelClass}>Resultado</span>
              </li>
            </ol>
          </nav>

          <p class={eyebrowClass}>Passo II</p>
          <h2 class={sectionTitleClass}>Meça a sua aliança</h2>
          <p class={instructionClass}>
            Apoie uma aliança que já serve na tela e ajuste o disco dourado até
            ele preencher todo o furo interno da aliança, encostando na borda
            por dentro.
          </p>

          <div class={ringStageClass} id='ring-stage-frame'>
            <div
              class='relative flex items-center justify-center rounded-full border-2 border-[#f3dfa4] bg-[radial-gradient(circle_at_38%_32%,#f3dfa4,#d4af37_45%,#b8860b_100%)] shadow-[0_20px_46px_-18px_rgba(212,175,55,.45),inset_0_0_22px_rgba(120,80,0,.35)] transition-[width,height] duration-75'
              id='ring-object'
              role='img'
              aria-label='Círculo de medição da aliança'
            >
              <span
                class={`${displayFont} text-2xl font-semibold text-[#1a1305] [text-shadow:0_1px_0_rgba(255,255,255,.25)]`}
                id='ring-live-aro'
              >
                16
              </span>
            </div>
          </div>

          <div class='mb-6 flex gap-3'>
            <div class={readoutClass}>
              <span class={readoutLabelClass}>Diâmetro interno</span>
              <span class={readoutValueClass} id='diameter-readout'>17,8 mm</span>
            </div>
            <div class={readoutAccentClass}>
              <span class={readoutLabelClass}>Aro estimado</span>
              <span class={`${readoutValueClass} text-[#f3dfa4]`} id='aro-readout'>16</span>
            </div>
          </div>

          <div class='mb-2' id='ring-control'>
            <div class='mb-2.5 flex items-baseline justify-between'>
              <label class={controlLabelClass} for='ring-slider'>
                Diâmetro do círculo
              </label>
            </div>
            <div class={controlRowClass}>
              <button
                class={fineButtonClass}
                type='button'
                id='ring-dec'
                aria-label='Diminuir 1 pixel'
              >
                &minus;
              </button>
              <input
                class={sliderClass}
                type='range'
                id='ring-slider'
                min='0'
                max='1'
                step='1'
                value='0'
              />
              <button
                class={fineButtonClass}
                type='button'
                id='ring-inc'
                aria-label='Aumentar 1 pixel'
              >
                &plus;
              </button>
            </div>
          </div>

          <div class='mt-2 flex items-center justify-between gap-4'>
            <button
              class={linkButtonClass}
              type='button'
              id='btn-recalibrate-from-step2'
            >
              &lsaquo; Recalibrar cartão
            </button>
            <button class={primaryButtonClass} type='button' id='btn-see-result'>
              Ver resultado
            </button>
          </div>
        </section>

        <section
          class={panelClass}
          id='panel-result'
          data-panel='result'
          aria-hidden='true'
          hidden
        >
          <nav class='mb-7' aria-label='Progresso'>
            <ol class='flex items-center gap-2.5'>
              <li class={stepItemBase}>
                <span class={stepNumDone}>I</span>
                <span class={stepLabelClass}>Calibrar</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumDone}>II</span>
                <span class={stepLabelClass}>Medir</span>
              </li>
              <li class={stepSeparatorClass} aria-hidden='true'></li>
              <li class={stepItemBase}>
                <span class={stepNumCurrent}>III</span>
                <span class={stepLabelClass}>Resultado</span>
              </li>
            </ol>
          </nav>

          <p class={eyebrowClass}>Resultado</p>
          <h2 class={sectionTitleClass}>O seu aro é</h2>

          <div
            class='mb-5 flex flex-col items-center rounded-[26px] border border-[#d4af37]/45 bg-[#141210] bg-[linear-gradient(180deg,rgba(212,175,55,.1),rgba(255,255,255,.02))] px-5 py-9 text-center'
          >
            <span
              class={`${displayFont} ${goldGradient} bg-clip-text text-8xl font-semibold leading-none text-transparent drop-shadow-[0_10px_30px_rgba(212,175,55,.25)] sm:text-9xl`}
              id='result-aro'
            >
              16
            </span>
            <span class='mt-3 text-sm text-[#d8d2c4]'>
              Diâmetro interno de
              <strong class='font-semibold text-[#f3dfa4]' id='result-diameter'>
                17,8 mm
              </strong>
            </span>
          </div>

          <p
            class='mb-7 rounded-r-md border-l-2 border-[#c9a24b] bg-[#d4af37]/5 px-4 py-3.5 text-[13px] leading-relaxed text-[#9c9587]'
          >
            <strong class='font-semibold text-[#d4af37]'>Atenção:</strong> esta
            medição possui margem de erro de 1 a 2 aros para mais ou para menos.
            Para uma medida exata e definitiva, recomendamos procurar uma de
            nossas lojas Daniel Carmassi.
          </p>

          <div class='mt-2 flex flex-col items-stretch gap-4 sm:flex-row'>
            <a
              class={`${primaryButtonClass} w-full flex-1`}
              href='#'
              id='btn-whatsapp'
              target='_blank'
              rel='noopener'
            >
              Falar no WhatsApp
            </a>
            <button
              class={`${ghostButtonClass} w-full flex-1`}
              type='button'
              id='btn-remeasure'
            >
              Medir de novo
            </button>
          </div>
        </section>
      </main>

      <footer class='mt-14 text-center text-xs uppercase text-[#9c9587]'>
        <p>Daniel Carmassi &mdash; Medidor de Aliança</p>
      </footer>
    </div>

    <script src='/assets/app.js' defer></script>
  </body>
</html>
